<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      One place to bump, and it must be bumped for every build handed over.
      A build's identity ends up in the session log's second line (see
      AppVersion), which is what makes a log from the field interpretable:
      two different binaries once carried the same stamp and the same bug was
      diagnosed twice.

      Pre-release counter, not SemVer: 0.0.1, 0.0.2, 0.0.3. The last field is
      the only one that moves until every roadmap phase is done and the user
      calls the project ready. See CLAUDE.md.
    -->
    <Version>0.0.3</Version>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
