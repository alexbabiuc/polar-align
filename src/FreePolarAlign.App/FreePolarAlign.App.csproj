<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FreePolarAlign.App</RootNamespace>
    <AssemblyName>FreePolarAlign.App</AssemblyName>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreePolarAlign.Session\FreePolarAlign.Session.csproj" />
    <ProjectReference Include="..\FreePolarAlign.Devices.Simulated\FreePolarAlign.Devices.Simulated.csproj" />
    <ProjectReference Include="..\FreePolarAlign.Solving\FreePolarAlign.Solving.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      D13's committed sample catalogue: the simulated observatory needs real
      stars to render, and the test projects already copy this file the same
      way (see FreePolarAlign.Tests.EndToEnd.csproj).
    -->
    <None Include="..\..\docs\fixtures\tycho2_subset.csv" Link="fixtures\tycho2_subset.csv" CopyToOutputDirectory="PreserveNewest" />

    <!--
      Installs the quad database beside the executable, where the application
      looks first (D13). Published with the application rather than kept
      alongside the build by hand, because the one copy that was kept by hand
      was lost.
    -->
    <None Include="..\..\scripts\Download-QuadDatabase.ps1" Link="Download-QuadDatabase.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Stamps the git commit into the assembly's informational version, so the
    session log's first line can name the exact build that wrote it (see
    Services/AppVersion.cs for why that turned out to matter). The SDK appends
    "+$(SourceRevisionId)" to InformationalVersion on its own once the property
    is set.

    ContinueOnError and IgnoreExitCode throughout: a build from a source archive,
    or on a machine without git, must still succeed. It just has no commit to
    report, and AppVersion says so rather than claiming a wrong one. Only this
    project runs it, since only this project logs the result.
  -->
  <Target Name="StampSourceRevision"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short=12 HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitCommitExitCode" />
    </Exec>

    <!--
      Uncommitted changes get a "dirty" suffix. Without it the stamp would name
      a commit whose code is not what is actually running, which is the very
      confusion this target exists to end.
    -->
    <Exec Command="git status --porcelain --untracked-files=no"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatus" />
    </Exec>

    <PropertyGroup Condition="'$(_GitCommitExitCode)' == '0' and '$(_GitCommit)' != ''">
      <SourceRevisionId>$(_GitCommit.Trim())</SourceRevisionId>
      <SourceRevisionId Condition="'$(_GitStatus)' != ''">$(_GitCommit.Trim())-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
