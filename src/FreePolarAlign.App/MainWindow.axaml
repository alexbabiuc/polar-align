<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FreePolarAlign.App.ViewModels"
        xmlns:devices="using:FreePolarAlign.Devices"
        xmlns:engine="using:FreePolarAlign.Core.Engine"
        x:Class="FreePolarAlign.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="free-polar-align"
        Width="1380" Height="880" MinWidth="1100" MinHeight="720">

  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#A8A8A8" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="BorderBrush" Value="#4A4A4A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Window.Styles>

  <Panel>

    <!--
      Everything is disabled while the driver's settings window is open, which
      is the whole of "modal" as far as this application can enforce it. The
      window belongs to the driver and sits on its own UI stack, so this process
      cannot own it; what it can do is refuse to do anything else, which is what
      the binding below does.

      The engine is blocked anyway, holding the command gate for as long as the
      window is up, so clicks that got through would queue behind something the
      user cannot see and arrive in a surprising order once it closed.
    -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="8"
        IsEnabled="{Binding !IsCameraSetupDialogOpen}">

    <!--
      Standing install-level warnings: a missing quad database (D13), a plugin
      that would not load (D4), an unwritable settings file. Always visible while
      they apply, never folded into the transient status line.
    -->
    <Border Grid.Row="0" Background="#553A1A" BorderBrush="#B8860B" BorderThickness="1" CornerRadius="4"
            Padding="10" IsVisible="{Binding HasWarnings}">
      <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#FFE9B0" />
    </Border>

    <!-- Transient status line, reconstructed entirely from the engine's event stream (D6). -->
    <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4" Padding="8">
      <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="380,*,360" ColumnSpacing="12">

      <!-- ================= Setup ================= -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">

          <!-- Camera -->
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <TextBlock Classes="h" Text="Camera" />
              <ComboBox ItemsSource="{Binding CameraOptions}"
                        SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding !IsCameraConnected}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="devices:DeviceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Connect" Command="{Binding ConnectCameraCommand}" />
                <Button Content="Disconnect" Command="{Binding DisconnectCameraCommand}" />
                <!--
                  ASCOM cameras only, and offered as soon as one is picked:
                  the driver's window is where a camera is set up before
                  anything connects to it. Gain, offset, USB bandwidth and
                  cooling live behind it, and for an ASCOM camera this
                  application sets none of them.
                -->
                <Button Content="Driver settings..." Command="{Binding OpenCameraSetupCommand}"
                        IsVisible="{Binding HasCameraSetupDialog}"
                        ToolTip.Tip="Opens the ASCOM driver's own settings window. Everything stops until you close it." />
              </StackPanel>

              <!--
                Native-SDK cameras only (ZWO, ToupTek), which have no driver
                window of their own; the SDK sets gain directly, so it gets a
                control here instead. A percentage of this camera's own range,
                because raw gain units differ by vendor and mean little to a
                person; the raw value is shown beneath for matching another
                program. Visible once such a camera is picked, editable once it
                is connected and has said what its range is.
              -->
              <StackPanel Spacing="4" IsVisible="{Binding ShowGainControl}">
                <TextBlock Classes="label" Text="Gain (% of this camera's range)" />
                <NumericUpDown Value="{Binding GainPercent, Mode=TwoWay}"
                               Minimum="0" Maximum="100" Increment="1" FormatString="0"
                               HorizontalAlignment="Stretch"
                               IsEnabled="{Binding IsGainEditable}"
                               ToolTip.Tip="Remembered for this camera. Lower gain is usually better here: a sky bright enough to swamp the stars is the commonest reason a solve fails." />
                <TextBlock Classes="label" Text="{Binding GainDetailText}" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Classes="value" Text="{Binding CameraSummary}" />
              <TextBlock Classes="label" Text="Sensor" />
              <TextBlock Classes="value" Text="{Binding CameraPixelText}" />

              <!--
                Only shown when the driver offers a genuine choice. Most cameras
                have one readout, and a menu of one implies a decision the user
                does not have to make.
              -->
              <StackPanel Spacing="4" IsVisible="{Binding HasReadoutModes}">
                <TextBlock Classes="label" Text="Readout mode" />
                <ComboBox ItemsSource="{Binding ReadoutModes}"
                          SelectedItem="{Binding SelectedReadoutMode, Mode=TwoWay}"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding IsReadoutModeEditable}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="engine:CameraReadoutModeDescription">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Fewer bits read out faster but quantise the frame more coarsely, which limits how precisely a star's centre can be measured." />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Mount -->
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <TextBlock Classes="h" Text="Mount" />
              <ComboBox ItemsSource="{Binding MountOptions}"
                        SelectedItem="{Binding SelectedMount, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding !IsMountConnected}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="devices:DeviceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Connect" Command="{Binding ConnectMountCommand}" />
                <Button Content="Disconnect" Command="{Binding DisconnectMountCommand}" />
              </StackPanel>
              <TextBlock Classes="value" Text="{Binding MountSummary}" />

              <!--
                Labelled as reported rather than as truth: on a misaligned mount
                this differs from where the telescope actually points by exactly
                the error being measured.
              -->
              <TextBlock Classes="label" Text="Reported position (the mount's own belief, not a solve)" />
              <TextBlock Classes="value" FontFamily="monospace" Text="{Binding MountCoordinatesText}" />

              <Border Background="#1F3A2A" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left"
                      IsVisible="{Binding IsTracking}">
                <TextBlock Text="{Binding TrackingText}" Foreground="#B6E8C6" FontSize="12" />
              </Border>
              <TextBlock Classes="value" Text="{Binding TrackingText}" IsVisible="{Binding !IsTracking}" />
              <TextBlock Classes="label" Text="{Binding PierSideText}" />

              <Border Background="#5A4A1E" BorderBrush="#B3943A" BorderThickness="1" CornerRadius="3" Padding="8"
                      IsVisible="{Binding ShowSlewUnsupportedNote}">
                <TextBlock Text="This driver reports no absolute-slew support (D9). Move the mount from its hand controller; each position is sampled once the mount settles (D10, D26)."
                           TextWrapping="Wrap" Foreground="#FFEFCB" FontSize="12" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Site -->
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <TextBlock Classes="h" Text="Observing site" />
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Reloaded from last time if it was stored, but it takes effect only when you confirm it. A latitude error appears one-for-one in the altitude figure below: 0.01° is already 0.6'." />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Latitude °N" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LatitudeText, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Longitude °E" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LongitudeText, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Altitude m" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HeightText, Mode=TwoWay}" />
              </Grid>
              <Button Content="Confirm site" Command="{Binding ConfirmSiteCommand}" HorizontalAlignment="Left" />
              <TextBlock Classes="label" Text="In use" />
              <TextBlock Classes="value" FontFamily="monospace" Text="{Binding SiteText}" />

              <Border Background="#5A4A1E" BorderBrush="#B3943A" BorderThickness="1" CornerRadius="3" Padding="8"
                      IsVisible="{Binding HasSiteDisagreement}">
                <TextBlock Text="{Binding SiteDisagreement}" TextWrapping="Wrap" Foreground="#FFEFCB" FontSize="12" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Optics -->
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <TextBlock Classes="h" Text="Optics" />
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Enter what you believe the focal length to be. The first solve measures it and replaces this figure." />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="label" Text="Focal length mm" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding FocalLengthText, Mode=TwoWay}" />
              </Grid>
              <Button Content="Apply focal length" Command="{Binding ApplyFocalLengthCommand}" HorizontalAlignment="Left" />
              <TextBlock Classes="value" Text="{Binding FocalLengthSummary}" />
              <TextBlock Classes="label" Text="{Binding PlateScaleText}" />
            </StackPanel>
          </Border>

          <!-- Sequence parameters -->
          <Border Classes="panel">
            <StackPanel Spacing="6">
              <TextBlock Classes="h" Text="Sequence" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Capture points" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CapturePointsText, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Sweep °" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SweepText, Mode=TwoWay}" />
              </Grid>
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Uncertainty falls as the square of the sweep but only as the square root of the number of points, so spend on sweep first." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ================= Measurement ================= -->
      <!--
        The one column that does not scroll, and deliberately: the numbers stay
        where they are and the frame view takes the height that is left.

        Scrolling was tried here and is worse. Inside a ScrollViewer a child is
        measured with unlimited height, so the image asked for its natural size
        (a 1200x800 frame in a 566px-wide column wants 377px) and the column
        scrolled even on a window with room to spare, putting the brightness
        control below the fold on every session. Letting the image shrink to the
        space available is what "Uniform" is for, and it only works when the
        space available is finite.

        ClipToBounds is the backstop: whatever the arithmetic, this column paints
        inside its own bounds rather than over its neighbours.
      -->
      <Grid Grid.Column="1" x:Name="MeasurementColumn" RowDefinitions="Auto,*" RowSpacing="10" ClipToBounds="True">
        <Border Grid.Row="0" Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="h" FontSize="18" Text="Alignment estimate" />
            <TextBlock Classes="label" Text="{Binding HemisphereText}" />

            <Border Background="#28304A" CornerRadius="4" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Total error (success is judged on this figure alone)" />
                <TextBlock Text="{Binding TotalErrorText}" FontSize="34" FontWeight="Bold" />
                <Border Background="#1F6F3F" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left"
                        IsVisible="{Binding IsGoodEnoughToStop}">
                  <TextBlock Text="Good enough to stop turning bolts (below 10')" Foreground="White" FontSize="12" />
                </Border>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Altitude error" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="Azimuth error" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AltitudeErrorText}" FontSize="20" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AzimuthErrorText}" FontSize="20" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="label" Text="Residual RMS (fit health)" />
                <TextBlock Text="{Binding ResidualRmsText}" FontSize="16" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Classes="label" Text="Progress" />
                <TextBlock Text="{Binding ProgressText}" FontSize="16" />
              </StackPanel>
            </Grid>

            <Border Background="#5A4A1E" BorderBrush="#B3943A" BorderThickness="1" CornerRadius="3" Padding="8"
                    IsVisible="{Binding HasSweepShortfall}">
              <TextBlock Text="{Binding SweepShortfall}" TextWrapping="Wrap" Foreground="#FFEFCB" FontSize="12" />
            </Border>
          </StackPanel>
        </Border>

        <!--
          The captured frame, always stretched. A linear rendering of an
          astronomical exposure is a black rectangle, so showing one unstretched
          was never a mode worth offering. The slider covers everything the old
          on/off toggle did, and covers it continuously. Nothing measured is
          computed from these pixels.

          A DockPanel rather than a Grid with a star row, because the frame view
          has to be whatever is *left over* and that is a subtraction, not a
          share. The previous version asked a star row for the remaining height
          and then put a 220px minimum on the image inside it: on a window short
          enough that the header and slider already filled the panel
          (any window with the install warnings banner showing), the panel
          demanded 220px it had not been given, and the image was drawn
          across the panels above and below it. Docking makes the leftover
          height exactly the leftover height, including when that is nothing.
        -->
        <!--
          Deliberately no MinHeight: a minimum is exactly what made the panel
          demand space it had not been given, and draw itself across its
          neighbours when it did not get it. The row it sits in is the height
          available, and the DockPanel inside hands the picture whatever the
          header and the brightness control leave.
        -->
        <Border Grid.Row="1" x:Name="CapturedFramePanel" Classes="panel" ClipToBounds="True">
          <DockPanel LastChildFill="True">
            <!--
              The correction reticle (D12) note lives on the title rather than on
              a line of its own: it is a standing note about a feature that does
              not exist yet, and a permanent line of it was taking its height
              from the picture.
            -->
            <!--
              Save frame shares the title's row, and is sized to the title's
              line height, for the reason the exposure picker shares the
              brightness row: a row of its own came out of the picture, which
              at the minimum window size has nothing to spare.
            -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBlock Grid.Column="0" Classes="h" Text="Captured frame" VerticalAlignment="Center"
                         ToolTip.Tip="Correction reticle (D12) still to come: its direction has to be derived from the solved CD matrix, and an arrow pointing the wrong way would be worse than none." />
              <Button Grid.Column="1" Content="Save frame..." Command="{Binding SaveFrameCommand}"
                      FontSize="12" Padding="8,1" MinHeight="0" VerticalAlignment="Center"
                      ToolTip.Tip="Saves the frame on screen as it came from the camera. Frames are otherwise deleted once the next one arrives, except those whose solve failed." />
            </Grid>

            <!--
              Only shown when a frame will not open, and then it is not a detail
              but the whole message: a camera writing truncated files, or a disk
              that has filled up mid-session. Bottom-docked before the brightness
              control so it sits at the very edge of the panel.
            -->
            <TextBlock DockPanel.Dock="Bottom" Classes="label" Foreground="#FFB0B0" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="{Binding FramePreviewProblem}"
                       IsVisible="{Binding HasFramePreviewProblem}" />
            <TextBlock DockPanel.Dock="Bottom" Classes="label" Foreground="#FFB0B0" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Text="{Binding SaveFrameProblem}"
                       IsVisible="{Binding HasSaveFrameProblem}" />

            <!--
              Both controls on one row, and the exposure picker docked here
              rather than in the Camera panel, because this is where the result
              of the choice is looked at: too long an exposure shows up as a
              washed-out frame in the picture above.

              One row rather than two is not tidiness. A second row cost the
              picture 38px, and at the minimum window size with the install
              warnings showing that took it under the 80px floor the layout test
              holds it to, which is the same failure mode that once had the
              frame drawn across its neighbours.
            -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
              <TextBlock Grid.Column="0" Classes="label" Text="Brightness" VerticalAlignment="Center" />
              <!--
                Height pinned because the stock control reserves 50px for a
                single horizontal track, and on a window at the minimum size
                that comes straight out of the picture above it. 32px is as
                tight as it goes: below that the thumb is clipped.
              -->
              <Slider Grid.Column="1" Minimum="0.08" Maximum="0.75" Value="{Binding StretchTarget, Mode=TwoWay}"
                      TickFrequency="0.01" IsSnapToTickEnabled="True" Height="32" VerticalAlignment="Center"
                      ToolTip.Tip="The frame's darkest pixel is always black and its brightest always white. This moves the midpoint between them, so nothing is clipped at either end whichever way it is dragged. The travel stops short of both ends on purpose: past them the picture stops gaining contrast and only fades." />

              <TextBlock Grid.Column="2" Classes="label" Text="Exposure" VerticalAlignment="Center" />
              <!--
                Enabled during a sequence too (D22 as revised): exposure changes
                how noisy a solved position is, not where it is, and the picture
                above is live, so this is where a brightening sky is answered.
              -->
              <ComboBox Grid.Column="3" ItemsSource="{Binding ExposureOptions}"
                        SelectedItem="{Binding SelectedExposure, Mode=TwoWay}"
                        MinHeight="32" VerticalAlignment="Center"
                        IsEnabled="{Binding IsExposureEditable}"
                        ToolTip.Tip="Applies from the next frame. Shorter is usually better here: these frames are measured for star positions, not looked at, and a sky bright enough to swamp the stars is the commonest reason a solve fails.">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExposureOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <!-- Fills whatever is left. -->
            <Border Background="#0A0A0A" CornerRadius="3" ClipToBounds="True">
              <Grid>
                <Image Source="{Binding FramePreview}" Stretch="Uniform"
                       IsVisible="{Binding HasFramePreview}" />
                <TextBlock Text="No frame yet. Frames appear here as soon as a camera is connected."
                           Classes="label" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasFramePreview}" />
              </Grid>
            </Border>
          </DockPanel>
        </Border>
      </Grid>

      <!-- ================= What to do next ================= -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">

          <!--
            What to do next, from whichever of the proposal and the manual
            instruction the engine gave last. At the top of the column because
            without a mount it is the whole of the guidance (D10): which
            declination to set, then how far to turn.

            The coordinates and the slew button appear only for a proposal that
            needs a slew. D18: the engine proposes and then waits, and the
            coordinates are editable because the engine cannot see trees, roofs
            or the one cloudy quadrant. Anything else is done at the mount and
            sampled once it settles (D26), so a button there would offer a
            movement that is not going to happen.
          -->
          <Border Background="#1E3A5A" BorderBrush="#3A7AB3" BorderThickness="1" CornerRadius="4" Padding="12"
                  IsVisible="{Binding HasGuidance}">
            <StackPanel Spacing="8">
              <TextBlock Text="NEXT STEP" FontWeight="Bold" Foreground="#B0D8FF" />
              <TextBlock Text="{Binding GuidanceInstruction}" TextWrapping="Wrap" Foreground="#DCEFFF" FontSize="15" />
              <TextBlock Text="{Binding ProposalDetail}" Classes="label" TextWrapping="Wrap"
                         IsVisible="{Binding HasProposalDetail}" />

              <StackPanel Spacing="4" IsVisible="{Binding ProposalRequiresMotion}">
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Right ascension: h m s (14:32:10) or decimal degrees (218.04)" />
                <TextBox Text="{Binding ProposalRaText, Mode=TwoWay}" FontFamily="monospace" />
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Declination: ° ' &quot; (-12 30 00) or decimal degrees (-12.5)" />
                <TextBox Text="{Binding ProposalDecText, Mode=TwoWay}" FontFamily="monospace" />
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Moving in declination starts a new sequence: points at different declinations do not lie on one circle about the polar axis." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Slew" Command="{Binding ConfirmProposalCommand}" Background="#1F5A8C" />
                  <Button Content="Restore suggested" Command="{Binding RestoreProposalCoordinatesCommand}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!--
            One line from the scheduling events (D26). Failed solves are counted
            here and not given a banner: while the mount is being turned most
            frames fail, and a warning that is always up is one nobody reads.
          -->
          <Border Background="#262626" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4" Padding="10"
                  IsVisible="{Binding HasSamplingStatus}">
            <StackPanel Spacing="4">
              <TextBlock Text="SAMPLING" FontWeight="Bold" Foreground="#C8C8C8" FontSize="12" />
              <TextBlock Text="{Binding SamplingStatusText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Background="#5A1E1E" BorderBrush="#B33A3A" BorderThickness="1" CornerRadius="4" Padding="10"
                  IsVisible="{Binding HasEntryError}">
            <StackPanel Spacing="4">
              <TextBlock Text="CHECK WHAT YOU TYPED" FontWeight="Bold" Foreground="#FFB0B0" />
              <TextBlock Text="{Binding EntryError}" TextWrapping="Wrap" Foreground="#FFDADA" />
            </StackPanel>
          </Border>

          <Border Background="#3A3A20" BorderBrush="#8C8C4A" BorderThickness="1" CornerRadius="4" Padding="10"
                  IsVisible="{Binding HasRejectionReason}">
            <StackPanel Spacing="4">
              <TextBlock Text="NOT POSSIBLE YET" FontWeight="Bold" Foreground="#E8E8B0" />
              <TextBlock Text="{Binding RejectionReason}" TextWrapping="Wrap" Foreground="#F0F0D0" />
            </StackPanel>
          </Border>

          <Border Background="#5A1E1E" BorderBrush="#B33A3A" BorderThickness="1" CornerRadius="4" Padding="10"
                  IsVisible="{Binding HasWithheldReason}">
            <StackPanel Spacing="4">
              <TextBlock Text="RESULT WITHHELD" FontWeight="Bold" Foreground="#FFB0B0" />
              <TextBlock Text="{Binding WithheldReason}" TextWrapping="Wrap" Foreground="#FFDADA" />
            </StackPanel>
          </Border>

          <Border Background="#5A1E1E" BorderBrush="#B33A3A" BorderThickness="1" CornerRadius="4" Padding="10"
                  IsVisible="{Binding HasFaultReason}">
            <StackPanel Spacing="4">
              <TextBlock Text="SEQUENCE FAULTED" FontWeight="Bold" Foreground="#FFB0B0" />
              <TextBlock Text="{Binding FaultReason}" TextWrapping="Wrap" Foreground="#FFDADA" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Commands (D6: buttons only ever send EngineCommands) and the event log. -->
    <!--
      The log is a fixed height so the columns above it keep the rest. 120px
      shows seven or eight lines, which is what anyone reads here before opening
      the file itself; it was 170, taken from the frame view, which needed it
      more on a window at the 720px minimum.
    -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,120" RowSpacing="6">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
        <Button Content="Start sequence" Command="{Binding StartCommand}"
                ToolTip.Tip="Needs a camera and a confirmed site. With no mount connected, positions come from blind solves and you move the telescope by hand." />
        <Button Content="Record sample" Command="{Binding RecordSampleCommand}"
                ToolTip.Tip="Uses the next frame to start as a sample now, whatever the spacing and settling checks say. The frame on screen is never used: it may have been exposed while the telescope was moving." />
        <Button Content="Stop sequence" Command="{Binding CancelCommand}" />
        <Button Content="Abort" Command="{Binding AbortCommand}" Background="#5A1E1E" />
      </StackPanel>

      <TextBlock Grid.Row="1" Classes="label" Text="{Binding LogPath, StringFormat='Full session log: {0}'}"
                 IsVisible="{Binding LogPath, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <Border Grid.Row="2" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4">
        <ListBox ItemsSource="{Binding Log}" Background="#101010" FontFamily="monospace" FontSize="12" />
      </Border>
    </Grid>
  </Grid>

    <!--
      Over the top, and hit-testable: a disabled control still lets a click
      through to whatever is behind it, and the point here is that nothing is
      behind it.
    -->
    <Border IsVisible="{Binding IsCameraSetupDialogOpen}" Background="#CC101010">
      <Border Classes="panel" Background="#1E1E1E" MaxWidth="460"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="8">
          <TextBlock Classes="h" Text="The camera driver's settings window is open" />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="It may have opened behind this window. Close it to carry on -- nothing else can happen until it is closed, because the settings behind it decide what the next exposure looks like." />
        </StackPanel>
      </Border>
    </Border>

  </Panel>
</Window>
