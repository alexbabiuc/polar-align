<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0, not net10.0-windows: the ToupTek SDK is a plain C library on every
      platform it ships for, so nothing here is Windows-specific. That also lets
      the layout and parsing tests run on the macOS build machine.
    -->
    <RootNamespace>FreePolarAlign.Devices.ToupTek</RootNamespace>
    <AssemblyName>FreePolarAlign.Devices.ToupTek</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Compiled against, never shipped beside: see D24 and the Ascom plugin's
    project file. Imaging is listed although nothing here names it, because it
    arrives transitively through Devices and would otherwise be copied beside
    the plugin all the same, which the first build of this project did.
  -->
  <ItemGroup>
    <ProjectReference Include="..\FreePolarAlign.Devices\FreePolarAlign.Devices.csproj"
                      Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\FreePolarAlign.Imaging\FreePolarAlign.Imaging.csproj"
                      Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    ToupTek's native library, from resources/touptek/camera, copied into the
    plugin's output by architecture, exactly as the ZWO plugin does with its
    own: with a runtime identifier only the matching DLL, beside the plugin;
    with none, both, in the runtimes/<rid>/native layout NativeLibraryLocator
    probes. These are the Windows x64 and x86 builds of SDK 60.32549.20260908.

    No notice is copied with them because the SDK carries none: no licence
    file, and no terms in its documentation or header. Bundling them was the
    user's decision with that known (D25).
  -->
  <PropertyGroup>
    <ToupTekNativeRoot>$(MSBuildThisFileDirectory)..\..\resources\touptek\camera\</ToupTekNativeRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="$(ToupTekNativeRoot)x64\toupcam.dll" Link="toupcam.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <None Include="$(ToupTekNativeRoot)x86\toupcam.dll" Link="toupcam.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <None Include="$(ToupTekNativeRoot)x64\toupcam.dll" Link="runtimes\win-x64\native\toupcam.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(ToupTekNativeRoot)x86\toupcam.dll" Link="runtimes\win-x86\native\toupcam.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The struct layouts are the thing most worth testing, and they are internal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FreePolarAlign.Tests.Devices" />
  </ItemGroup>

</Project>
